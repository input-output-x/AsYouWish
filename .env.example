# LLM 配置
# mock = 离线演示（无需 API Key）
# openai / deepseek = 真实 AI 生成
LLM_PROVIDER=mock

# OpenAI（LLM_PROVIDER=openai 时填写）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（LLM_PROVIDER=deepseek 时填写）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 私有故事提示词配置（JSON 的 Base64，仅在使用真实 LLM 时需要）
# 请通过部署平台的 Secret / Environment Variables 注入，禁止提交真实值
STORY_PROMPT_CONFIG_BASE64=

# 产品分析（可选；未配置时事件仅保存在用户本机）
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# TTS（默认 Edge 神经语音 · 晓晓 · 温柔女声）
TTS_PROVIDER=edge
TTS_FEMALE_VOICE=zh-CN-XiaoxiaoNeural
TTS_FEMALE_RATE=0.92
TTS_FEMALE_PITCH=+0Hz
TTS_MALE_VOICE=zh-CN-YunyangNeural
TTS_MALE_RATE=0.90
TTS_MALE_PITCH=-8Hz
NEXT_PUBLIC_TTS_PROVIDER=edge

# 高德（阶段 1.5，可选）
AMAP_API_KEY=
