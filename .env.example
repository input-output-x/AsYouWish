# LLM 配置
# mock = 离线演示（无需 API Key）
# openai / deepseek = 真实 AI 生成
LLM_PROVIDER=mock

# OpenAI（LLM_PROVIDER=openai 时填写）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（LLM_PROVIDER=deepseek 时填写）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# TTS（默认 Edge 神经语音 · 晓晓 · 温柔女声）
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=0.92
TTS_PITCH=+0Hz
NEXT_PUBLIC_TTS_PROVIDER=edge

# 高德（阶段 1.5，可选）
AMAP_API_KEY=
